<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_res_config_settings_form_inherit_mg_ai_base" model="ir.ui.view">
        <field name="name">res.config.settings.form.inherit.mg.ai.base</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app string="AI Integrations" name="mg_ai_base" logo="/mg_ai_base/static/description/icon.png">
                    <block title="AI Routing" name="mg_ai_routing_block">
                        <div class="text-muted">
                            Choose one AI model per AI type. First choose a type, then one of its allowed AI providers, then a model filtered by both.
                        </div>
                        <field name="mg_ai_routing_ids" nolabel="1">
                            <list string="AI Routing" editable="bottom">
                                <field name="company_id" column_invisible="1"/>
                                <field name="available_ai_provider_ids" column_invisible="1"/>
                                <field name="ai_type_id" domain="[('is_active', '=', True)]" options="{'no_create': True, 'no_create_edit': True, 'no_open': True}"/>
                                <field name="ai_provider_id" domain="[('id', 'in', available_ai_provider_ids)]" options="{'no_create': True, 'no_create_edit': True, 'no_open': True}"/>
                                <field name="ai_model_id" domain="[('ai_type_id', '=', ai_type_id), ('ai_provider_id', '=', ai_provider_id), ('is_active', '=', True)]" options="{'no_create': True, 'no_create_edit': True, 'no_open': True}"/>
                            </list>
                        </field>
                    </block>
                </app>
            </xpath>
        </field>
    </record>

</odoo>
