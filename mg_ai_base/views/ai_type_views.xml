<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_mg_ai_type_tree" model="ir.ui.view">
        <field name="name">mg.ai.type.tree</field>
        <field name="model">mg.ai.type</field>
        <field name="arch" type="xml">
            <list string="AI Types">
                <field name="name"/>
                <field name="ai_provider_ids" widget="many2many_tags"/>
                <field name="is_active"/>
            </list>
        </field>
    </record>

    <record id="view_mg_ai_type_form" model="ir.ui.view">
        <field name="name">mg.ai.type.form</field>
        <field name="model">mg.ai.type</field>
        <field name="arch" type="xml">
            <form string="AI Type">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="ai_provider_ids" widget="many2many_tags"/>
                        <field name="is_active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

</odoo>
