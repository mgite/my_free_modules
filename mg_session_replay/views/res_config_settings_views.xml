<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_res_config_settings_form_inherit_mg_session_replay" model="ir.ui.view">
        <field name="name">res.config.settings.form.inherit.mg.session.replay</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app string="Session Replay" name="mg_session_replay" logo="/mg_session_replay/static/description/icon.png">
                    <block title="Capture Buffer" name="mg_session_replay_capture_buffer">
                        <setting id="mg_session_replay_recording_duration">
                            <field name="mg_session_replay_recording_duration_seconds"/>
                            <div class="text-muted">
                                Keep a rolling browser-side buffer for this many seconds before an error is saved.
                            </div>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>

</odoo>
