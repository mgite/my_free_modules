<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_debug_session_capture_tree" model="ir.ui.view">
        <field name="name">debug.session.capture.tree</field>
        <field name="model">debug.session.capture</field>
        <field name="arch" type="xml">
            <list string="Session Replay Captures">
                <header>
                    <button
                        name="action_raise_test_error"
                        type="object"
                        string="Trigger Test Error"
                        class="btn-secondary"
                        display="always"
                        groups="base.group_system"
                    />
                </header>
                <field name="name"/>
                <field name="captured_at"/>
                <field name="user_id"/>
                <field name="duration_seconds"/>
            </list>
        </field>
    </record>

    <record id="view_debug_session_capture_form" model="ir.ui.view">
        <field name="name">debug.session.capture.form</field>
        <field name="model">debug.session.capture</field>
        <field name="arch" type="xml">
            <form string="Session Replay Capture">
                <sheet>
                    <group>
                        <group>
                            <field name="name" readonly="1"/>
                            <field name="user_id" readonly="1"/>
                            <field name="captured_at" readonly="1"/>
                            <field name="duration_seconds" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="AI Analysis">
                            <field name="ai_analysis_html" widget="html" readonly="1" nolabel="1"/>
                        </page>
                        <page string="Recording JSON">
                            <field name="recording" widget="text" readonly="1" nolabel="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_debug_session_capture_search" model="ir.ui.view">
        <field name="name">debug.session.capture.search</field>
        <field name="model">debug.session.capture</field>
        <field name="arch" type="xml">
            <search string="Session Replay Captures">
                <field name="name"/>
                <field name="user_id"/>
                <field name="captured_at"/>
                <filter name="filter_today" string="Today" domain="[('captured_at', '&gt;=', context_today())]"/>
                <separator/>
                <group>
                    <filter name="group_user" string="User" context="{'group_by': 'user_id'}"/>
                    <filter name="group_captured_at" string="Captured At" context="{'group_by': 'captured_at:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_debug_session_capture" model="ir.actions.act_window">
        <field name="name">Session Replay Captures</field>
        <field name="res_model">debug.session.capture</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_debug_session_capture_search"/>
    </record>

    <menuitem
        id="menu_mg_session_replay_root"
        name="Session Replay"
        parent="base.menu_administration"
        sequence="210"
        groups="base.group_system"
    />

    <menuitem
        id="menu_debug_session_capture"
        name="Captures"
        parent="menu_mg_session_replay_root"
        action="action_debug_session_capture"
        sequence="10"
        groups="base.group_system"
    />

</odoo>
